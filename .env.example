# GridOS API credentials — never commit real values; use a secrets manager for shared keys
GRIDOS_API_KEY=
GRIDIOS_API_BASE_URL=

# Emperor (AC Evo game server panel) — no API key required, read-only
EMPEROR_ACEVO_BASE_URL=

# Discord — SRA-Bot integration channel webhook. Posting "profile_updated|<discord_id>"
# here makes the bot resync that member's nickname + division role. Must be the
# webhook the bot filters on (INTEGRATION_WH_ID, id 1021527577724190800); unset
# disables the nudge. The token in this URL is a secret — never commit it.
DISCORD_INTEGRATION_WEBHOOK_URL=

# Application
NODE_ENV=development
API_PORT=3000
